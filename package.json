{
  "name": "oreui-web",
  "version": "0.1.0-beta.1",
  "description": "An unofficial Ore UI Web Component library.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katorlys/OreUI.git"
  },
  "keywords": [
    "ore-ui",
    "oreui",
    "minecraft",
    "bedrock",
    "css",
    "component",
    "library",
    "component-library",
    "minecraft-ui",
    "style",
    "pixel",
    "ui",
    "ugc"
  ],
  "homepage": "https://katorly.dev/OreUI",
  "bugs": {
    "url": "https://github.com/katorlys/OreUI/issues"
  },
  "license": "MPL-2.0",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/styles.css",
    "./dist/components/**/*.js",
    "!./dist/components/scrollbar-controller/**/*.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./components/*": {
      "types": "./dist/components/*/*.d.ts",
      "import": "./dist/components/*/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./dist/assets/*",
    "./icons/*": "./dist/icons/*.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:core",
    "build:core": "vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "docs:build": "pnpm --filter @katorlys/oreui-docs build",
    "docs:dev": "pnpm --filter @katorlys/oreui-docs dev",
    "docs:typecheck": "pnpm --filter @katorlys/oreui-docs typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm typecheck:core",
    "typecheck:core": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
